{
  "name": "nwsdb-wtp-designer",
  "productName": "NWSDB WTP Designer",
  "version": "1.8.1",
  "description": "Conventional water treatment plant design suite for the National Water Supply & Drainage Board, Sri Lanka",
  "main": "electron/main.js",
  "author": "National Water Supply & Drainage Board, Sri Lanka",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "node build/build.mjs",
    "start": "node build/build.mjs && electron .",
    "dev": "node build/build.mjs --dev && electron .",
    "test": "node test/engine.test.mjs",
    "dist": "node build/build.mjs && electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "d3": "7.9.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.12",
    "esbuild": "0.28.2",
    "jszip": "3.10.1",
    "katex": "0.16.47"
  },
  "build": {
    "appId": "lk.gov.nwsdb.wtpdesigner",
    "productName": "NWSDB WTP Designer",
    "copyright": "National Water Supply & Drainage Board, Sri Lanka",
    "files": ["electron/**", "dist/**", "package.json"],
    "directories": { "output": "release" },
    "fileAssociations": [{ "ext": "wtpd", "name": "WTP Designer project", "description": "NWSDB WTP Designer project", "icon": "assets/icon.ico", "role": "Editor" }],
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon.ico" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "NWSDB WTP Designer" }
  }
}
